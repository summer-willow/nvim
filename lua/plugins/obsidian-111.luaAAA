return {
  "epwalsh/obsidian.nvim",
  version = "*",  -- 최신 안정 버전 사용
  lazy = true,
  ft = "markdown",
  dependencies = {
    "nvim-lua/plenary.nvim",
    "nvim-telescope/telescope.nvim", -- 검색 및 링크 선택용 필수
    "nvim-treesitter/nvim-treesitter",
  },
  config = function()
    require("obsidian").setup({
      -- 1. 저장소 위치 설정
      workspaces = {
        {
          -- name = "personal",
          name = "stc222",

          -- path = "~/vaults/personal", -- 본인의 옵시디언 보관함 경로로 수정하세요.
          path = "C:/stc_obsidian222/stc222", -- 작업 공간의 루트 경로(path)
        },
      },

      -- 2. 데일리 노트 설정 (별도 폴더 분리)
      daily_notes = {
        folder = "dailies", -- vaults/personal/dailies/ 폴더에 저장됨
        date_format = "%Y-%m-%d",
        alias_format = "%Y년 %m월 %d일 일기",
      },

      -- 3. 핵심: 파일 이름 생성 규칙 (YYYYMMDD-HHMM-이름.md)
      note_id_func = function(title)
        local suffix = ""
        if title ~= nil then
          -- 공백을 하이픈(-)으로 치환하고 소문자 변환 (유연한 공백 처리)
          suffix = title:gsub(" ", "-"):gsub("[^%w-_]", ""):lower()
        else
          -- 이름이 없을 경우를 대비한 랜덤 4자리
          for _ = 1, 4 do
            suffix = suffix .. string.char(math.random(65, 90))
          end
        end
        -- 오늘 날짜-시간-이름 반환
        return tostring(os.date("%Y%m%g-%H%M")) .. "-" .. suffix
      end,

      -- 4. 핵심: [[링크]] 생성 시 본문 표시(Alias) 처리 규칙
      -- [[20260810-0024-bbb|bbb]] 형태로 자동 변환되어 화면에는 bbb만 보임
      note_path_func = function(spec)
        local path = spec.dir / tostring(spec.id)
        return path:with_suffix(".md")
      end,

      wiki_link_func = function(opts)
        return require("obsidian.util").wiki_link_id_prefix(opts)
      end,

      -- 5. 템플릿 설정 (기본적인 메타데이터 제공)
      templates = {
        folder = "templates", -- vaults/personal/templates/ 폴더 생성 필요
        date_format = "%Y-%m-%d",
        time_format = "%H:%M",
        substitutions = {},
      },

      -- 옵시디언 기본 내장 매핑 비활성화 (우리가 직접 직관적으로 지정하기 위함)
      mappings = {},
    })



    -- -- 6. 사람들이 가장 많이 쓰는 직관적인 단축키 설정 (리더키 공간 활용)
    -- local map = vim.keymap.set
    -- -- nn: New Note (새 메모 생성)
    -- map("n", "<leader>on", ":ObsidianNew ", { desc = "새 옵시디언 메모 생성" })
    -- -- oo: Open (Telescope로 메모 검색해서 열기)
    -- map("n", "<leader>oo", "<cmd>ObsidianSearch<cr>", { desc = "메모 본문/제목 검색" })
    -- -- ol: Link (기존 메모를 현재 커서 위치에 링크로 삽입)
    -- map("n", "<leader>ol", "<cmd>ObsidianLink<cr>", { desc = "기존 메모 링크 삽입" })
    -- -- od: Daily (오늘의 데일리 노트 열기/생성)
    -- map("n", "<leader>od", "<cmd>ObsidianToday<cr>", { desc = "오늘의 데일리 노트" })
    -- -- ot: Template (현재 파일에 템플릿 삽입)
    -- map("n", "<leader>ot", "<cmd>ObsidianTemplate<cr>", { desc = "템플릿 삽입" })
    -- -- 커서 아래의 [[링크]] 파일로 이동 (엔터 키처럼 사용)
    -- map("n", "<gd>", "<cmd>ObsidianFollowLink<cr>", { desc = "링크된 파일로 이동" })




  end,

  -- stc가 붙인것
  keys = {
    -- [ 생성 및 검색 ]
    { "<leader>on", "<cmd>ObsidianNew<cr>", desc = "새 노트 생성 (new note)" },
    { "<leader>os", "<cmd>ObsidianSearch<cr>", desc = "전체 텍스트 검색 (search note)" },
    { "<leader>oq", "<cmd>ObsidianQuickSwitch<cr>", desc = "파일명으로 빠른 찾기 (quickly switch)" },

    -- [ 태그 및 관리 ]
    { "<leader>ot", "<cmd>ObsidianTags<cr>", desc = "태그 검색 (전용) (tags)" },
    { "<leader>or", ":ObsidianRename ", desc = "노트 이름 바꾸기 (Rename)" },
    { "<leader>ox", "<cmd>ObsidianSmartDelete<cr>", desc = "스마트 노트 삭제 (백링크 확인) (delete)" },
    -- vim.keymap.set("n", "<leader>ox", "<cmd>ObsidianSmartDelete<cr>", { desc = "Smart Delete Obsidian Note" })

    -- [ 일기/데일리 (Daily 전용) ]
    { "<leader>oa", "<cmd>ObsidianToday<cr>", desc = "오늘의 일일 노트 (at Today)" },
    { "<leader>ol", "<cmd>ObsidianDailies<cr>", desc = "데일리 노트 목록 (List)" },
    -- vim.keymap.set('n', '<leader>od', '<cmd>ObsidianDailies<cr>', { desc = '데일리 노트 목록 (Telescope)' })

    -- [ 이동 및 링크 ]
    { "<leader>of", "<cmd>ObsidianFollowLink<cr>", desc = "링크 따라가기 (follow link)" },
    { "<leader>ob", "<cmd>ObsidianBacklinks<cr>", desc = "현재 노트의 백링크 보기 (backlinks)" },
  },

}
