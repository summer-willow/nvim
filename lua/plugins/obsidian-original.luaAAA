-- ---------------------------------------
-- Origianl obsidian.nvim 
--
-- 1. 사용할 폴더 이름을 로컬 변수로 선언합니다.
local my_inbox = "00_Inbox"

return {
  "epwalsh/obsidian.nvim",
  version = "*",  -- 최신 릴리스 버전 사용
  lazy = true,
  ft = "markdown",  -- 마크다운 파일에서만 로드
  dependencies = {
    "nvim-lua/plenary.nvim",
  },
  opts = {
    -- -----------------------------------
    -- {{{ 옵시디언 보관소 경로 설정
    --
    -- 옵시디언 보관소 경로 설정
    -- workspace: 옵시디언의 '보관소(vault)'와 대응되는 개념으로, 노트가 저장된 경로를 설정
    -- 여러 개의 보관소를 사용한다면 리스트 형태로 추가
    -- 주의: path: 윈도우 경로를 작성할 때는 역슬래시(`\`) 대신 슬래시(`/`)를 사용하거나 역슬래시를 두 번(`\\`) 써서 경로 인식을 정확하게 합니다.
    -- -----------------------------------
    -- }}}
    workspaces = {
      {
        name = "stc",
        path = "C:/stc_obsidian/stc", -- 작업 공간의 루트 경로(path)
        -- notes_subdir = "00_Inbox", -- 여기에 적힌 폴더로 새 노트가 들어감
        notes_subdir = my_inbox, -- 여기에 적힌 폴더로 새 노트가 들어감
      },
      -- {
      --   name = "work",
      --   path = "C:/stc_obsidian/work",
      -- },
    },
    new_notes_location = "notes_subdir",
    -- "새 노트를 만들 때 해당 workspace의 notes_subdir 경로를 사용해라"
    -- 최종적으로 C:/stc_obsidian/stc/00_Inbox/로 최종 저장


    -- ---------------------------------------
    -- 새 노트 생성 시 ID 규칙 (제목을 파일명으로 사용)
    -- ---------------------------------------


    -- ---------------------------------------
    -- type 2
    -- -- 새 노트 생성 시 파일명은 '202606282300' 같은 숫자로 생성
    note_id_func = function(title)
      local suffix = ""
      -- 제목이 있을 때
      if title ~= nil then
        -- "알파벳, 숫자, 하이픈(-), 언더바(_)를 제외한 모든 특수문자(한글/문장부호 등)는 전부 지워라!"
        suffix = title:gsub(" ", "-"):gsub("[^%w-_]", "")
      else
        -- 제목이 없으면 무작위로 영문 대문자 4글자 추가
        for _ = 1, 4 do
          suffix = suffix .. string.char(math.random(65, 90))
        end
      end
      -- 최종 파일명 예시: 1719583200-My-New-Note.md
      -- 제목이 잇을 때 최종 반환값: "00_Inbox/1719583200-My-Note"
      -- 제목이 없을 때 최종 반환값: "00_Inbox/1719583200-BXAZ"
      return my_inbox .. "/" .. tostring(os.time()) .. "-" .. suffix
    end,

    -- {{{
    --[[
    코드 서명: 

    이 코드들은 파일 이름으로 쓸 수 없는 공백이나 특수문자를 깔끔하게 청소하고, 제목이 없을 때 겹치지 않는 랜덤 문자를 만들어내는 역할을 합니다. 한 구절 한 구절 쪼개서 속 시원하게 설명해 드릴게요!

    ---

    ## 주요 단어 정리

    * **gsub**: 글로벌 치환 (global substitution, 특정 패턴을 찾아 바꾸는 Lua 함수)
    * **string.char**: 숫자를 아스키(ASCII) 코드 문자로 변환하는 함수
    * **math.random**: 무작위 숫자를 무작위로 뽑아내는 함수

    ---

    ## 1. 첫 번째 구문 완전 분석

    `suffix = title:gsub(" ", "-"):gsub("[^%w-_]", "")`

    이 한 줄은 "체인(Chain) 방식"으로 작동합니다. 첫 번째 청소를 하고 나온 결과물에 곧바로 두 번째 청소를 연속으로 처리하는 구조입니다. 입력값이 `"My Note? 2026!"`이라고 가정하고 단계별로 따라가 보겠습니다.

    ### ① `gsub(" ", "-")` 가 하는 일

    * **의미**: 문자열 전체를 샅샅이 뒤져서 **공백(`" "`)을 찾은 뒤, 모두 하이픈(`"-"`)으로 체인지**하라는 뜻입니다.
    * **이유**: 파일 이름에 띄어쓰기가 있으면 나중에 터미널이나 동기화 프로그램에서 경로가 깨지는 버그를 유발할 수 있어 안전하게 이어붙이는 것입니다.

    ### ② `title:gsub(" ", "-")` 의 결과

    * **동작**: `title` 변수에 든 값의 공백을 하이픈으로 바꿉니다.
    * **결과**: `"My Note? 2026!"` $\rightarrow$ **`"My-Note?-2026!"`** (공백 2개가 하이픈으로 변경됨)

    ### ③ `gsub("[^%w-_]", "")` 가 하는 일 (패턴 매칭)

    이 부분이 조금 난해해 보일 수 있지만, 기호를 하나씩 뜯어보면 아주 단순합니다.

    * `[` `]` : 이 대괄호 안의 문자 세트들을 찾겠다는 뜻입니다.
    * `^` : 대괄호 안의 맨 앞에 붙은 `^`는 "~을 제외하고 모두" (NOT)라는 반대 의미가 됩니다.
    * `%w` : **알파벳 대소문자와 숫자** (Word의 약자, a-z, A-Z, 0-9)를 의미합니다.
    * `-_` : 하이픈(`-`)과 언더바(`_`) 기호 자체를 의미합니다.
    * `, ""` : 이렇게 찾아낸 것들을 `""`(빈 문자열)로 바꿔서 없애버려라(삭제)는 뜻입니다.

    > **💡 한 줄 요약**: **"알파벳, 숫자, 하이픈(-), 언더바(_)를 제외한 모든 특수문자(한글/문장부호 등)는 전부 지워라!"**라는 뜻입니다.

    ### ④ 결과적으로 `suffix = title:gsub(" ", "-"):gsub("[^%w-_]", "")` 는 어떻게 되나요?

    1. **1단계 (`gsub(" ", "-")`)**: `"My Note? 2026!"` $\rightarrow$ `"My-Note?-2026!"`
    2. **2단계 (`gsub("[^%w-_]", "")`)**: 알파벳/숫자/하이픈이 아닌 물음표(`?`)와 느낌표(`!`)를 찾아서 삭제합니다.
    3. **최종 suffix 결과**: **`"My-Note-2026"`**

    ---

    ## 2. 두 번째 구문 완전 분석

    `suffix = suffix .. string.char(math.random(65, 90))`

    이 줄은 사용자가 제목을 입력하지 않았을 때(엔터만 쳤을 때), `"ABCD"` 같은 무작위 대문자 4개를 생성하기 위해 `for` 루프 안에서 **4번 반복 실행**되는 코드입니다. 안쪽 가장 작은 단위부터 밖으로 나오며 설명해 드릴게요.

    ### ① `math.random(65, 90)`

    * 컴퓨터 세상에서 영문 대문자 **'A'는 숫자 65**, **'Z'는 숫자 90**이라는 고유 번호(아스키 코드)를 가집니다.
    * `math.random(65, 90)`은 **65부터 90 사이의 무작위 정수(숫자) 하나를 무작위로 뽑아라**라는 명령어입니다.
    * *예시: 첫 번째 바퀴에서 숫자 `66`이 뽑혔다고 가정합시다.*

    ### ② `string.char( ... )`

    * 이 함수는 안쪽에 들어온 **숫자 번호를 사람이 읽을 수 있는 실제 문자로 변환**해 줍니다.
    * 위에서 뽑힌 숫자 `66`을 `string.char(66)`에 넣으면, 컴퓨터는 아스키 코드표를 보고 알파벳 대문자 `"B"`를 만들어 냅니다.

    ### ③ `suffix = suffix .. 문자가 된 결과`

    * Lua에서 **`..` 연산자는 앞뒤 문자열을 본드로 붙이듯 이어붙이는 기능**을 합니다.
    * 원래 비어있던 `suffix = ""` 상자에 방금 뽑힌 영문자를 차곡차곡 이어붙여 누적합니다.

    ### ④ 4번의 반복문(`for _ = 1, 4 do`) 동안 누적되는 과정

    * **처음 상태**: `suffix = ""`
    * **1번째 바퀴**: `66` 뽑힘 $\rightarrow$ `"B"` 변환 $\rightarrow$ `suffix = "" .. "B"` $\rightarrow$ **`"B"`**
    * **2번째 바퀴**: `88` 뽑힘 $\rightarrow$ `"X"` 변환 $\rightarrow$ `suffix = "B" .. "X"` $\rightarrow$ **`"BX"`**
    * **3번째 바퀴**: `65` 뽑힘 $\rightarrow$ `"A"` 변환 $\rightarrow$ `suffix = "BX" .. "A"` $\rightarrow$ **`"BXA"`**
    * **4번째 바퀴**: `90` 뽑힘 $\rightarrow$ `"Z"` 변환 $\rightarrow$ `suffix = "BXA" .. "Z"` $\rightarrow$ **`"BXAZ"`**
    * **최종 suffix 결과**: **`"BXAZ"`**

    ---

    ## 📌 요약: 최종 파일 이름은 어떻게 만들어지나요?

    ### Case A: 제목을 `"My Note!"`라고 직접 쳤을 때

    1. 공백과 특수문자가 정제되어 `suffix = "My-Note"` 가 됩니다.
    2. 현재 시간 초 단위 타임스탬프(예: `1719583200`)와 결합합니다.
    3. 최종 반환값: **`"00_Inbox/1719583200-My-Note"`** (뒤에 `.md`가 붙어서 저장됨)

    ### Case B: 제목 없이 그냥 엔터를 쳤을 때

    1. 제목이 없으므로 랜덤 루프를 돌며 `suffix = "BXAZ"` 같은 랜덤 4글자가 생성됩니다.
    2. 현재 시간 타임스탬프와 결합합니다.
    3. 최종 반환값: **`"00_Inbox/1719583200-BXAZ"`**

    이렇게 깔끔하고 정밀하게 설계되어 있기 때문에, 파일 이름이 시스템에서 꼬이거나 중복될 걱정 없이 안전하게 `00_Inbox` 폴더로 들어가게 되는 것이랍니다!

    --]]
    --
    -- }}}

    -- ---------------------------------------









    -- -----------------------------------
    -- {{{ 보관함 내의 새 노트를 생성할 때의 형식
    --
    -- 보관함 내의 새 노트를 생성할 때의 형식
    -- 새 파일이 어디에 생길지 결정
    -- 이 설정은 `ObsidianNew` 명령어로 새로운 노트를 만들 때, 그 파일을 **보관소(Vault) 내의 어디에 저장할 것인가**를 결정합니다.
    --
    -- *   **의미**: 새 노트를 보관소의 최상위(Root)가 아니라, **특정 하위 디렉토리(Sub-directory)**에 모아서 생성하겠다는 뜻입니다.
    -- *   **작동 방식**: 이 옵션을 사용하려면 `workspaces` 설정 안에 `notes_subdir`이라는 항목이 정의되어 있어야 합니다.
    --
    -- * notes_subdir: 보관소(Vault) 전체가 아닌, 설정에서 지정한 특정 하위 폴더에 노트를 만들겠다는 의미입니다.
    -- new_notes_location = 'notes_subdir',
    --
    -- *   **사용 이유**: 보관소 최상위 폴더가 수많은 메모 파일로 어지러워지는 것을 방지하기 위해 사용합니다. 보통 'inbox'나 'notes' 같은 폴더를 지정해 두고 새 메모를 일단 그곳에 몰아넣는 용도로 씁니다.
    -- }}}

    -- -----------------------------------
    -- {{{ Obsidian의 위키 링크 스타일 유지
    --
    -- Obsidian의 위키 링크 스타일 유지
    --노트끼리 연결할 때 어떤 모양으로 연결할지 결정
    -- 
    -- *   **의미**: 옵시디언 사용자들에게 익숙한 **`[[위키 링크]]`** 형식을 우선적으로 사용하겠다는 뜻입니다.
    -- *   **비교**:
    --     *   **wiki (선택된 설정)**: `[[Meeting Notes 2026]]` 처럼 대괄호 두 개를 사용합니다. 읽기 쉽고 옵시디언 앱과의 호환성이 가장 좋습니다.
    --     *   **markdown**: `[Meeting Notes 2026](Meeting%20Notes%202026.md)` 처럼 표준 마크다운 형식을 사용합니다. 옵시디언 외의 다른 마크다운 편집기(GitHub, VS Code 등)에서도 링크가 깨지지 않고 잘 작동해야 할 때 유리합니다.
    -- *   **사용 이유**: 질문자님은 이미 옵시디언을 메인으로 사용하고 계시므로, 옵시디언의 핵심 기능(그래프 뷰, 백링크 등)과 가장 잘 어우러지는 `wiki` 스타일을 유지하는 것이 가장 현명한 선택입니다.
    --
    -- 이 설정은 다른 노트를 링크하거나 이미지 등을 삽입할 때 **링크의 문법 스타일**을 결정합니다.
    -- * wiki link: `[[파일명]]` 형태의 링크 스타일로, 옵시디언의 가장 대표적인 연결 방식입니다. cf) markdown link 스타일
    -- cf) * markdown link: `[표시될 이름](파일경로)` 형태의 표준 마크다운 연결 방식입니다.
    -- }}}
    preferred_link_style = 'wiki',
    -- -----------------------------------

    -- ---------------------------------------------------
    -- {{{ 일일 노트 설정 (Daily Notes)
    --
    -- 일일 노트 설정 (Daily Notes)
    -- `folder`를 지정하면 해당 폴더 안에 설정한 날짜 형식으로 새 노트를 생성하거나 기존 노트를 바로 엽니다.
    -- C:/stc_obsidian/dailies 폴더에 저장됨
    -- }}}
    -- ---------------------------------------------------
    -- {{{ 특정 날짜의 daily-notes 로 이동하기
    --
    -- 특정 날짜의 daily-notes 로 이동하기
    --
    -- ### 특정 날짜로 이동하기
    -- :ObsidianDailies
    -- 작동 방식: 이 명령어를 입력하면 지금까지 작성된 모든 데일리 노트의 목록이 **Telescope** 창에 뜹니다.
    -- 목록에서 날짜를 검색하거나 화살표로 선택해서 엔터를 치면 해당 날짜의 노트로 바로 이동합니다.
    --
    -- 어제 노트로 이동: :ObsidianYesterday
    -- 내일 노트로 이동: :ObsidianTomorrow
    -- 오늘 노트로 이동: :ObsidianToday
    --
    -- ex) keymap 만들기
    -- { "<leader>od", "<cmd>ObsidianDailies<cr>", desc = "데일리 노트 목록 (Telescope)" },
    -- ---------------------------------------------------
    -- }}}
    daily_notes = {
      folder = "dailies",
      date_format = "%Y-%m-%d",
    },

    -- 이미지 및 첨부파일 저장 경로
    -- 이미지 저장 설정
    attachments = {
      img_folder = "attachments",
    },

    -- 자동완성(Completion) 설정 (nvim-cmp 사용 시)
    completion = {
      nvim_cmp = false,
      -- blink.cmp 사용 시 에러 방지를 위해 false로 설정
      min_chars = 2,
    },

    -- ---------------------------------------------------
    -- {{{ UI 및 가독성 설정 (체크박스, 링크 등을 예쁘게 표시)
    --
    -- UI 및 가독성 설정 (체크박스, 링크 등을 예쁘게 표시)
    --
    -- `ui.enable = true` 설정을 통해 체크박스나 강조 구문을 아이콘으로 시각화할 수 있습니다.
    -- conceal: 마크다운의 복잡한 문법 기호를 숨기고 깔끔하게 보여주는 기능
    -- obsidian.nvim`은 링크(`[[link]]`)나 체크박스를 예쁘게 보여주기 위해 문법 기호를 숨기는 기능을 사용하는데, 이를 위해, Neovim 설정 파일(`options.lua` 등)에 `vim.opt.conceallevel = 2`를 추가하거나, 옵시디언 플러그인 설정 내에서 이 값을 강제로 지정해줘야 합니다.
    -- conceallevel: 마크다운의 기호(`[[ ]]`, `**` 등)를 숨기고 깔끔하게 보여주는 정도를 결정하는 Neovim 설정값
    -- ---------------------------------------------------
    -- }}}
    ui = {
      enable = false,  -- false: obsidian.nvim 자체 UI 렌더링을 비활성화, UI 렌더링은 render-makrdown.의 설정을 따른다
      -- ----------------------
      -- {{{ render-markdown.nvim이 ui 담담
      -- --> opts.ui.unable=false 로 해 두었기 때문에 ui에 관련된 설정은 적용되지 않는다. 따라서. 주석 처리.
      -- --> 대신, render-markdown.nvim 이 모든 md 파일의 ui를 담당한다.
      -- }}}
      -- ----------------------
      --
      conceallevel = 2,   -- 마크다운 기호 숨김 활성화 (render-markdown 작동 필수 조건)
      --
      -- update_debounce = 200,  -- 200 ms = 0.2 sec,  udate_debounce 값 때까지 다음 입력이 없을 때,  UI 렌더링 하라

      -- 옵시디언 특유의 기호들을 표시
      checkboxes = {
        [" "] = { char = "󰄱", hl_group = "ObsidianTodo" },
        ["x"] = { char = "", hl_group = "ObsidianDone" },
      },
    },
  },

  config = function(_, opts)
    -- opts에 정의된 내용을 바탕으로 플러그인을 초기화합니다.
    require("obsidian").setup(opts)

    -- --------------------------------
    -- 스마트한 삭제 루틴
    -- 백링크 확인 → 삭제 여부 확인 → 버퍼 닫기 및 파일 삭제를 한 번에 처리하는 루틴

    -- 커스텀 스마트 삭제 명령어 정의
    vim.api.nvim_create_user_command("ObsidianSmartDelete", function()
      local obsidian = require("obsidian")
      local client = obsidian.get_client()
      local note = client:current_note()
      -- current_note: 현재 버퍼가 Obsidian 관리 하에 있는 유효한 노트인지 확인하는 메서드.

      if not note then
        print("현재 파일이 Obsidian 노트가 아닙니다.")
        return
      end

      -- 백링크 먼저 보여주기 (Telescope 활용)
      vim.cmd("ObsidianBacklinks")

      -- 사용자 확인 대기 (Telescope 창이 뜨는 시간 고려)
      -- 백링크를 확인한 후, 실제로 지울지 결정하도록 안내.
      -- defer_fn: 특정 시간(밀리초)만큼 실행을 지연시키는 함수입니다. 여기서는 Telescope 창이 뜨는 속도와 맞추기 위해 사용했습니다.
      vim.defer_fn(function()
        local confirm = vim.fn.confirm(
          "위의 백링크를 확인하셨나요? '" .. note.title .. "' 노트를 삭제할까요?",
          "&Yes\n&No",
          2
        )

        if confirm == 1 then
          local path = vim.api.nvim_buf_get_name(0)
          -- 버퍼를 강제로 닫고 파일을 삭제합니다.
          vim.cmd("bdelete!")
          local success, err = os.remove(path)
          -- success, err: 파일 삭제 시 성공 여부와 에러 메시지를 받아오는 일반적인 Lua 패턴.
          if success then
            print("노트가 성공적으로 삭제되었습니다.")
          else
            print("삭제 실패: " .. (err or "알 수 없는 오류"))
          end
        else
          print("삭제가 취소되었습니다.")
        end
      end, 500) -- Telescope 창이 뜨는 시간을 고려해 0.5초 뒤에 확인 창을 띄웁니다.
    end, { desc = "Check backlinks and delete obsidian note" })
    -- --------------------------------

  end,

  keys = {
    -- [ 생성 및 검색 ]
    { "<leader>on", "<cmd>ObsidianNew<cr>", desc = "새 노트 생성 (new note)" },
    { "<leader>os", "<cmd>ObsidianSearch<cr>", desc = "전체 텍스트 검색 (search note)" },
    { "<leader>oq", "<cmd>ObsidianQuickSwitch<cr>", desc = "파일명으로 빠른 찾기 (quickly switch)" },

    -- [ 태그 및 관리 ]
    { "<leader>ot", "<cmd>ObsidianTags<cr>", desc = "태그 검색 (전용) (tags)" },
    { "<leader>or", ":ObsidianRename ", desc = "노트 이름 바꾸기 (Rename)" },
    { "<leader>ox", "<cmd>ObsidianSmartDelete<cr>", desc = "스마트 노트 삭제 (백링크 확인) (delete)" },
    -- vim.keymap.set("n", "<leader>ox", "<cmd>ObsidianSmartDelete<cr>", { desc = "Smart Delete Obsidian Note" })

    -- [ 일기/데일리 (Daily 전용) ]
    { "<leader>oa", "<cmd>ObsidianToday<cr>", desc = "오늘의 일일 노트 (at Today)" },
    { "<leader>ol", "<cmd>ObsidianDailies<cr>", desc = "데일리 노트 목록 (List)" },
    -- vim.keymap.set('n', '<leader>od', '<cmd>ObsidianDailies<cr>', { desc = '데일리 노트 목록 (Telescope)' })

    -- [ 이동 및 링크 ]
    { "<leader>of", "<cmd>ObsidianFollowLink<cr>", desc = "링크 따라가기 (follow link)" },
    { "<leader>ob", "<cmd>ObsidianBacklinks<cr>", desc = "현재 노트의 백링크 보기 (backlinks)" },
  },


  -- -------------------------
  -- by stc
  --

  -- {{{ 혖재 줄에 checkbox 만들고, checkbox toggle 하기 (미완료 [ ] <-> 완료 [x])
  --
  -- 혖재 줄에 checkbox 만들고, checkbox toggle 하기 (미완료 [ ] <-> 완료 [x])
  --
  -- ObsidianToggleCheckbox : 이 명령은 기본적으로 checkbox의 여러 상태(~, ~, > , x)를 순서대로 순환(cycle)하면서 checkbox를 toggle 시킨다.
  --
  -- 만약, [ ]와 [x] 두 가지 사이에만 toggle 하고 싶으면 아래 2가지 방법을 쓰면 된다
  -- 1) [ ]와 [x] 두 가지만 되도록 하는 obsidian.nvim의 설정과 키바인딩
  -- 2) obsidian.nvim의 설정을 건들지 않고, 곧바로 keymap 설정에서 obsidian.nvim의 함수들을 이용하는 바업
  --
  -- --------
  -- 방법 1
  --
  -- [ ]와 [x] 두 가지만 되도록 하는 설정
  --  checkboxes = {
  --    [" "] = { char = "󰄱", hl_group = "ObsidianTodo" },
  --    ["x"] = { char = "", hl_group = "ObsidianDone" },
  --   },
  -- vim.keymap.set("n", "<leader>tt", "<cmd>ObsidianToggleCheckbox<cr>", { desc = "체크리스트 완료 토글" })
  -- cf) ObsidianToggleCheckbox 명령은 일반 줄에서도 맨 앞에 체크박스를( - [ ]) 생성함으로, 무조건 현재 줄을 체크박스 줄로 만든다.
  -- --------
  --
  -- --------
  -- 방법 2
  -- 플러그인 설정 건들지 않고 단축키만 수정하기
  --
  -- 현재 줄의 체크리스트 상태를 토글 (미완료 [ ] <-> 완료 [x])
  -- 만약 플러그인 전체 설정을 건드리기 번거롭다면, 단축키 줄에서 obsidian.nvim 내부 유틸리티 함수에 직접 인자값({ " ", "x" })을 전달하여 키바인딩을 만든다
  -- -- 단축키 매핑에서 직접 빈칸(" ")과 x만 순환하라고 명시하는 방법
  -- vim.keymap.set("n", "<leader>tt", function()
  --   require("obsidian").util.toggle_checkbox({ " ", "x" })
  -- end, { desc = "체크리스트 완료 토글 ([ ] <-> [x])" })
  -- --------
  -- }}}
  --
  -- 현재 줄의 체크리스트 상태를 토글 (미완료 [ ] <-> 완료 [x])
      -- [ ]와 [x] 두 가지만 되도록 하는 설정
  -- 위의 opts.ui.checkboxesdp 에 열거된 체크박스 상태들을 순서적으로 순환(cycle) 하면서 toggle
  vim.keymap.set("n", "<leader>tt", "<cmd>ObsidianToggleCheckbox<cr>", { desc = "체크리스트 완료 토글" })
  -- ==> 기본적으로 <CR>로 이미 구현되어 있다. 따라서 위 키맵 설정은 없어도 된다.
  -- cf) ObsidianToggleCheckbox 명령은 일반 줄에서도 맨 앞에 체크박스를( - [ ]) 생성함으로써, 
  -- 무조건 현재 줄을 체크박스 줄로 만든다.
  --
  -- by stc, end
  -- -------------------------
  --
}
