

--[[

moc (map of content): 지식의 지도 역할을 하는 문서로, 관련 노트들을 한곳에 링크로 묶어 체계적으로 관리하는 허브 노트를 뜻합니다.

markdown link: [표시할 이름](파일명) 형태로 작성되는 표준 마크다운 링크 방식입니다.

wiki link: [ [파일명] ] 또는 [[파일명|표시할 이름] ] 형태로 작성되는 Obsidian 고유의 간결한 링크 방식입니다.

두 가지 방식(선 작성 후 링크, 선 가상 링크 후 작성

1. 새로운 노트를 먼저 만들고 MOC에 링크하기 (Bottom-Up 방식)


--]]


--[[
return {
  "epwalsh/obsidian.nvim",
  version = "*", -- 최신 안정 버전을 사용합니다.
  lazy = true,
  -- obsidian이나 markdown 파일 타입이 열릴 때만 로드되도록 지연 로딩 설정
  ft = "markdown",
  -- 명령어 기반으로도 지연 로딩이 동작하도록 설정
  cmd = {
    "ObsidianNew",
    "ObsidianLink",
    "ObsidianSearch",
    "ObsidianFollowLink",
  },
  dependencies = {
    "nvim-lua/plenary.nvim",
    "nvim-telescope/telescope.nvim", -- 검색 UI 연동을 위해 필수
    "Saghen/blink.cmp",              -- 자동완성을 위해 의존성 명시 (Blink가 먼저 로드되도록)
  },
  config = function()
    require("obsidian").setup({
      -- 1. 가장 중요한 금고(Vault) 경로 설정
      workspaces = {
        {
          name = "personal",
          -- 본인의 실제 Obsidian Vault 절대 경로 또는 상대 경로를 적어주세요.
          -- path = "~/OneDrive/Obsidian/MainVault",
          path = "C:/stc_obsidian222/stc222", -- 작업 공간의 루트 경로(path)
        },
      },

      -- 2. 검색 및 매핑 UI로 어떤 플러그인을 쓸지 결정
      -- telescope.nvim이 설치되어 있으므로 'telescope'로 지정합니다.
      finder = "telescope",

      -- 3. 링크 스타일 설정
      -- 'wiki'로 설정하면 [ [노트이름] ] 형태로 링크가 생성됩니다.
      -- 'markdown'으로 설정하면 [노트이름](노트이름.md) 형태로 생성됩니다.
      link_style = "wiki",

      -- 4. 2번 워크플로우(가상 링크)를 위한 핵심 설정
      -- 존재하지 않는 가상 링크 위에서 gf를 눌렀을 때, 새 노트를 어느 폴더에 만들지 결정합니다.
      -- nil로 두면 현재 편집 중인 MOC 파일과 같은 폴더에 생성됩니다.
      new_notes_location = "current_dir",

      -- 5. 새 노트를 생성할 때 파일 이름을 어떻게 지정할지 정의하는 함수
      -- title이 있으면 title을 파일명으로 쓰고, 없으면 렌덤 ID 대신 기본 포맷을 씁니다.
      note_id_func = function(title)
        if title ~= nil then
          -- 공백이나 특수문자를 깔끔하게 유지하거나 다듬고 싶다면 여기서 처리합니다.
          -- 여기서는 입력한 title 그대로 파일명이 되도록 설정합니다.
          return title
        else
          -- title 없이 :ObsidianNew만 쳤을 때 생성될 임시 파일명 규칙
          return tostring(os.time()) .. "-untitled"
        end
      end,

      -- 6. blink.cmp(또는 네이티브 LSP)와의 연동을 위한 내장 컴플리션 활성화
      -- 이 설정을 켜야 인서트 모드에서 '[['를 칠 때 blink.cmp가 소스를 받아옵니다.
      completion = {
        nvim_cmp = true, -- 내부적으로 nvim-cmp 호환 API를 쓰기 때문에 true로 둡니다.
        min_chars = 2,   -- '[[' 입력 후 최소 2글자를 더 입력하면 자동완성이 팝업됩니다.
      },

      -- 7. 1번, 2번 워크플로우를 가속화할 편리한 단축키(Keymaps) 설정
      -- 플러그인 내부에 내장된 매핑 기능을 사용합니다.
      mappings = {
        -- 2번 워크플로우의 핵심: 링크 위에서 'gf'를 누르면 링크를 따라가거나(Follow), 
        -- 파일이 없으면 '디지털 필터 기초.md' 처럼 가상 링크의 이름으로 새 파일을 생성합니다.
        ["gf"] = {
          action = function()
            return require("obsidian").util.gf_passthrough()
          end,
          opts = { noremap = false, expr = true, buffer = true, desc = "링크 따라가기 / 가상링크 파일 생성" },
        },
        -- 체크박스 토글 ([ ] <-> [x])
        ["<leader>ch"] = {
          action = function()
            return require("obsidian").util.toggle_checkbox()
          end,
          opts = { buffer = true, desc = "체크박스 토글" },
        },
      },
    })

    -- 8. 추가적인 전역 단축키 정의 (어느 파일에서나 Obsidian 명령을 호출할 수 있게)
    -- 1번 워크플로우: 새 노트를 바로 만들 때 사용합니다.
    vim.keymap.set("n", "<leader>on", "<cmd>ObsidianNew<CR>", { desc = "Obsidian: 새 노트 생성" })
    -- 1번 워크플로우: MOC 안에서 기존 노트를 검색해 링크로 쏙 집어넣을 때 씁니다.
    vim.keymap.set("n", "<leader>ol", "<cmd>ObsidianLink<CR>", { desc = "Obsidian: 기존 노트 링크 삽입" })
    -- 볼트 전체 안에서 텍스트나 제목으로 노트를 검색해 열 때 씁니다 (Telescope 팝업)
    vim.keymap.set("n", "<leader>os", "<cmd>ObsidianSearch<CR>", { desc = "Obsidian: 노트 전체 검색" })
  end,
}
--]]
























