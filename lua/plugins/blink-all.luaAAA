-- -----------------------------------------------
-- 3단계: 최종 자동 변환 활성화 코드
-- -----------------------------------------------
return {
  -- 1. 트리시터 설정 (수식 영역 감지 유지)
  -- {
  --   "nvim-treesitter/nvim-treesitter",
  --   build = ":TSUpdate",
  --   config = function()
  --     require("nvim-treesitter.configs").setup({
  --       ensure_installed = { "latex" },
  --       highlight = { enable = true },
  --     })
  --   end,
  -- },

  -- 2. LuaSnip 본체 & 자동 변환 전역 활성화
  {
    "L3MON4D3/LuaSnip",
    dependencies = {
      "iurimateus/luasnip-latex-snippets.nvim",
    },
    config = function()
      local ls = require("luasnip")

      -- 🌟 핵심: LuaSnip 본체에 자동 변환 옵션을 주입합니다.
      ls.config.setup({
        enable_autosnippets = true, -- 자동 스니펫 전역 활성화
        -- 타이핑 시 글자가 바뀔 때마다 실시간으로 스니펫 조건식을 평가합니다.
        update_events = "TextChanged,TextChangedI",
      })

      -- 레이텍 외부 플러그인 로드 (트리시터 연동)
      require("luasnip-latex-snippets").setup({
        use_treesitter = false, -- whether to use treesitter to determine if cursor is in math mode; if false, vimtex is used
        allow_on_markdown = true, -- whether to add snippets to markdown filetype
        --
      })
    end,
  },

  -- 3. Blink.cmp 설정 (완성 소스 복구)
  -- {
  --   "saghen/blink.cmp",
  --   version = "*",
  --   opts = {
  --     keymap = { preset = "default" },
  --     snippets = {
  --       preset = "luasnip", -- Blink가 LuaSnip을 바라보도록 고정
  --     },
  --     -- sources = {
  --     --   -- 디버깅용으로 껐던 기본 추천 소스(LSP, 경로 등)를 다시 안전하게 복구합니다.
  --     --   default = { "lsp", "path", "snippets", "buffer" },
  --     -- },
  --     sources = { default = { "snippets" } },
  --   },
  -- },


}





